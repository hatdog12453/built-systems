            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api","auth","logout"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test if logout was successful",
                  "pm.test(\"Logout successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Clear all authentication data",
                  "pm.collectionVariables.set('token', '');",
                  "pm.collectionVariables.set('user_id', '');",
                  "pm.collectionVariables.set('user_role', '');",
                  "pm.collectionVariables.set('user_email', '');",
                  "",
                  "// Also clear environment variables",
                  "pm.environment.set('auth_token', '');",
                  "pm.environment.set('user_id', '');",
                  "pm.environment.set('user_role', '');",
                  "pm.environment.set('user_email', '');",
                  "",
                  "console.log('✅ Logout successful - all tokens cleared');",
                  "console.log('🔑 You will need to login again for protected endpoints');"
