{
  "info": {
    "name": "Fitness Coaching API - Full",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "fitness-coaching-api-full"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "user_role", "value": "" },
    { "key": "user_email", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-login if no token exists and we're not already in an auth request",
          "const currentUrl = pm.request.url.toString();",
          "const isAuthRequest = currentUrl.includes('/auth/');",
          "const hasToken = pm.collectionVariables.get('token');",
          "",
          "if (!hasToken && !isAuthRequest) {",
          "    console.log('🔑 No token found, you may need to login first');",
          "    console.log('💡 Tip: Run any login request to automatically get a token');",
          "} else if (hasToken) {",
          "    console.log('✅ Token found:', pm.collectionVariables.get('token').substring(0, 20) + '...');",
          "    console.log('👤 User Role:', pm.collectionVariables.get('user_role'));",
          "    console.log('📧 User Email:', pm.collectionVariables.get('user_email'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register - Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/admin/register", "host": ["{{baseUrl}}"], "path": ["api","auth","admin","register"] },
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Super Admin\",\n  \"email\": \"admin2@example.com\",\n  \"password\": \"password\",\n  \"security_question\": \"What's your mother's maiden name?\",\n  \"security_answer\": \"Smith\"\n}" }
          }
        },
        {
          "name": "Login - Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/admin/login", "host": ["{{baseUrl}}"], "path": ["api","auth","admin","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test if login was successful",
                  "pm.test(\"Admin login successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has token\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('token');",
                  "});",
                  "",
                  "// Extract and save token automatically",
                  "if (pm.response.code === 200) {",
                  "    const responseJson = pm.response.json();",
                  "    if (responseJson.token) {",
                  "        // Save to collection variables (primary)",
                  "        pm.collectionVariables.set('token', responseJson.token);",
                  "        pm.collectionVariables.set('user_id', responseJson.user.id);",
                  "        pm.collectionVariables.set('user_role', 'admin');",
                  "        pm.collectionVariables.set('user_email', responseJson.user.email);",
                  "        ",
                  "        // Also save to environment variables as backup",
                  "        pm.environment.set('auth_token', responseJson.token);",
                  "        pm.environment.set('user_id', responseJson.user.id);",
                  "        pm.environment.set('user_role', 'admin');",
                  "        pm.environment.set('user_email', responseJson.user.email);",
                  "        ",
                  "        console.log('✅ Admin token saved successfully');",
                  "        console.log('Token:', responseJson.token);",
                  "        console.log('User ID:', responseJson.user.id);",
                  "        console.log('User Email:', responseJson.user.email);",
                  "        console.log('Role: Admin');",
                  "    }",
                  "} else {",
                  "    console.log('❌ Admin login failed - no token saved');",
                  "    console.log('Response:', pm.response.text());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
